{
  "$schema": "https://opencode.ai/config.json",
  "model": "kimi-for-coding/k2p5",
  "default_agent": "build",
  "agent": {
    "plan": {
      "mode": "primary",
      "description": "Planning and analysis agent using Xiaomi MiMo-V2.5-Pro",
      "model": "openrouter/xiaomi/mimo-v2.5-pro",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "write": "deny",
        "apply_patch": "deny"
      }
    },
    "kimi-coding": {
      "mode": "primary",
      "description": "Coding agent powered by Kimi K2.6 for implementation tasks",
      "model": "moonshotai/kimi-k2.6",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "write": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    }
  },
  "mcp": {
    "browsermcp": {
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@latest"
      ],
      "enabled": true,
      "type": "local"
    },
    "control-chrome": {
      "command": [
        "chrome-devtools-mcp"
      ],
      "type": "local"
    }
  },
  "plugin": [
    "opencode-browser",
    "opencode-scheduler"
  ]
}
