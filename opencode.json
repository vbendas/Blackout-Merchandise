{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "openwork",
  "mcp": {
    "browsermcp": {
      "command": [
        "npx",
        "-y",
        "@browsermcp/mcp@latest"
      ],
      "enabled": true,
      "type": "local"
    },
    "control-chrome": {
      "command": [
        "chrome-devtools-mcp"
      ],
      "type": "local"
    }
  },
  "plugin": [
    "opencode-browser",
    "opencode-scheduler"
  ],
  "model": "kimi-for-coding/k2p5"
}
