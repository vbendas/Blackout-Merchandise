{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-scheduler",
    "Chrome",
    "OpenCode Browser"
  ],
  "model": "kimi-for-coding/k2p5",
  "mcp": {
    "control-chrome": {
      "type": "local",
      "enabled": true,
      "command": [
        "chrome-devtools-mcp"
      ]
    }
  }
}
