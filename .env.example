# ============================================================
# MerchFrom — Environment Variables
# Copy this file to .env.local and fill in your values.
# ============================================================

# --- Database (Neon PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB"

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=  # Format: pk_test_...
CLERK_SECRET_KEY=                  # Format: sk_test_...
CLERK_WEBHOOK_SECRET=              # Format: whsec_...

# --- Payments (Stripe) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=  # Format: pk_test_...
STRIPE_SECRET_KEY=                   # Format: sk_test_...
STRIPE_WEBHOOK_SECRET=               # Format: whsec_...

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=  # Format: sk-or-v1-...

# --- Voice (Deepgram) — Optional ---
DEEPGRAM_API_KEY=

# --- Media (Cloudinary) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=  # e.g. my-cloud

# --- Cache (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=   # e.g. https://my-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN= # Format: my-upstash-token

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============================================================
# Taskmaster / Dev Tool API Keys (not needed for the app)
# ============================================================
ANTHROPIC_API_KEY=        # Optional. Format: sk-ant-api03-...
PERPLEXITY_API_KEY=       # Optional. Format: pplx-...
OPENAI_API_KEY=           # Optional. Format: sk-proj-...
GOOGLE_API_KEY=           # Optional. For Google Gemini models.
MISTRAL_API_KEY=          # Optional. For Mistral AI models.
XAI_API_KEY=              # Optional. For xAI AI models.
AZURE_OPENAI_API_KEY=     # Optional. For Azure OpenAI models.
OLLAMA_API_KEY=           # Optional. For remote Ollama servers.
GITHUB_API_KEY=           # Optional. Format: ghp_...