# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="REDACTED"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="REDACTED"     # Optional: Format: pplx-...
OPENAI_API_KEY="REDACTED"             # Optional, for OpenAI/OpenRouter models. Format: sk-proj-...
GOOGLE_API_KEY="REDACTED"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="REDACTED"               # Optional, for Mistral AI models.
XAI_API_KEY="REDACTED"                       # Optional, for xAI AI models.
AZURE_OPENAI_API_KEY="REDACTED"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="REDACTED"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="REDACTED"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...